# Public URL of the site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ulsturiintulaan.com

# Neon Postgres connection string. Without it, orders run in test mode (logged, not saved).
DATABASE_URL=

# Resend API key + verified sender. Without the key, emails are skipped.
RESEND_API_KEY=
EMAIL_FROM="Улс төрийн тулаан <orders@ulsturiintulaan.com>"

# Where order notifications and contact messages are delivered.
ORDER_NOTIFY_EMAIL=

# Admin dashboard at /admin. Leave empty to disable it (the page returns 404).
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions (defaults to one derived from the password).
ADMIN_SESSION_SECRET=

# Telegram push for every new order. Create a bot with @BotFather, send it a message,
# then put the bot token and your chat id here (several ids: comma separated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
