# Public URL of the site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ulsturiintulaan.com

# Neon Postgres connection string. Without it, orders run in test mode (logged, not saved).
DATABASE_URL=

# Resend API key + verified sender. Without the key, emails are skipped.
RESEND_API_KEY=
EMAIL_FROM="Улс төрийн тулаан <orders@ulsturiintulaan.com>"

# Where order notifications and contact messages are delivered.
ORDER_NOTIFY_EMAIL=
